    <category term="闲聊杂谈" scheme="https://lunanorth.github.io/categories/%E9%97%B2%E8%81%8A%E6%9D%82%E8%B0%88/"/>
    <category term="随记" scheme="https://lunanorth.github.io/tags/%E9%9A%8F%E8%AE%B0/"/>
